# Build context is the repo root for both backend/Dockerfile and
# frontend/Dockerfile. Keep heavy and sensitive files out of the context.

# VCS / editor
.git
.gitignore
.vscode
.DS_Store

# Env & secrets (provided at runtime, never baked into images)
**/.env
**/*.env

# Python
**/__pycache__
**/*.py[cod]
**/.venv
**/.mypy_cache
**/.ruff_cache
**/*.egg-info

# Node / frontend
**/node_modules
frontend/dist
frontend/.tanstack

# Logs & misc
*.log
backend/uploads

# Docs / local-only
DEPLOYMENT.md
