# Domain
DOMAIN=localhost

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="Full Stack FastAPI Project"
STACK_NAME=full-stack-fastapi-project

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails (optional)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Azure SQL Database
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database
AZURE_SQL_USER=your-user
AZURE_SQL_PASSWORD="your-password"
AZURE_SQL_PORT=1433

SENTRY_DSN=

# Azure Form Recognizer (required for document processing)
FR_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
FR_KEY=your-azure-form-recognizer-key
FR_MODEL_ID=prebuilt-document

# Server / process
# Number of uvicorn worker processes launched by `fastapi run --workers`.
# Read at container startup (not by the app itself). Mirror this into the Azure
# Container App env vars. Each worker is a full app copy (memory), so on a
# 4 vCPU / 4 GiB backend use 2.
FASTAPI_WORKERS=2

# Document processing
UPLOAD_DIR=uploads
PDF_RENDER_DPI=216
# Background PDF-render concurrency PER worker. Effective concurrency across the
# container is FASTAPI_WORKERS × PROCESSOR_CONCURRENCY. For a 4 vCPU / 4 GiB
# backend use 2 (2 × 2 = 4 concurrent renders).
PROCESSOR_CONCURRENCY=3

# Azure Blob Storage (optional). When both values are set, uploaded PDFs and
# rendered page images are stored in the blob container instead of the local
# UPLOAD_DIR. AZURE_STORAGE_CONTAINER_URL is the container URL WITHOUT any query
# string; AZURE_STORAGE_SAS_TOKEN is the SAS query string (leading "?" optional).
AZURE_STORAGE_CONTAINER_URL=https://your-account.blob.core.windows.net/your-container
AZURE_STORAGE_SAS_TOKEN=your-sas-token

# Azure OpenAI (for DB chat)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview
